{
    "name":  "playwright-automation-share-ed",
    "version":  "1.0.0",
    "description":  "",
    "main":  "index.js",
    "scripts":  {
                    "test":  "playwright test --config=playwright/playwright.config.js --project=chromium",
                    "test:firefox": "playwright test --config=playwright/playwright.config.js --project=firefox",
                    "test:webkit": "playwright test --config=playwright/playwright.config.js --project=webkit",
                    "test:chrome": "playwright test --config=playwright/playwright.config.js --project=chrome",
                    "test:edge": "playwright test --config=playwright/playwright.config.js --project=msedge",
                    "test:all-browsers": "playwright test --config=playwright/playwright.config.js --project=chromium --project=firefox --project=webkit",
                    "test:post":  "playwright test --config=playwright/playwright.config.js playwright/tests/post/create-post.spec.js --project=chromium",
                    "test:headed":  "playwright test --config=playwright/playwright.config.js --project=chromium --headed",
                    "test:ui":  "playwright test --config=playwright/playwright.config.js --ui",
                    "test:robot": "node robot/run.cjs robot/tests --outputdir artifacts/robot/results",
                    "test:robot:dryrun": "node robot/run.cjs robot/tests --dryrun --outputdir artifacts/robot/dryrun",
                    "test:robot:smoke": "node robot/run.cjs robot/checks/browser_smoke.robot --outputdir artifacts/robot/smoke"
                },
    "keywords":  [

                 ],
    "author":  "",
    "license":  "ISC",
    "type":  "commonjs",
    "devDependencies":  {
                            "@playwright/test":  "^1.63.0",
                            "@types/node":  "^26.6.2"
                        },
    "dependencies":  {
                         "playwright":  "^1.63.0"
                     }
}
